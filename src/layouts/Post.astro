---
import Base from './Base.astro';
import { u } from '../lib/url';
const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="wrap prose">
    <a class="label" href={u('/blog/')}>← all posts</a>
    <h1>{frontmatter.title}</h1>
    <p class="post-meta">{date} · {frontmatter.tag}</p>
    <slot />
  </article>
</Base>

<style is:global>
  .prose { max-width: 760px; padding-block: 56px 80px; }
  .prose h1 { font-size: clamp(30px, 5vw, 44px); margin: 16px 0 8px; }
  .prose .post-meta { font-family: var(--f-mono); font-size: 13px; color: var(--muted); margin-bottom: 32px; }
  .prose h2 { font-size: 24px; margin: 40px 0 12px; }
  .prose p, .prose li { color: #c9d1da; margin-bottom: 14px; }
  .prose ul, .prose ol { padding-left: 22px; }
  .prose a { color: var(--accent); }
  .prose code { font-family: var(--f-mono); font-size: 0.9em; background: var(--panel); padding: 2px 5px; border-radius: 3px; }
  .prose pre { background: var(--panel) !important; border: 1px solid var(--line); border-radius: 6px; padding: 16px; overflow-x: auto; margin-bottom: 18px; }
  .prose pre code { background: none; padding: 0; }
</style>
